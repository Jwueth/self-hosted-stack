# ═══════════════════════════════════════════════════
#  Global .env — selfhosted-stack
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ═══════════════════════════════════════════════════

# ─── Identity & Network ──────────────────────────
DOMAIN=example.com
TAILSCALE_IP=100.x.x.x
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
TZ=Europe/Zurich
PUID=1000
PGID=1000

# ─── Shared password ─────────────────────────────
# Used by: postgres, pgadmin, calibre, nextcloud admin
ADMIN_PASSWORD=

# ─── Authelia ─────────────────────────────────────
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# ─── PostgreSQL shared ────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── AI stack ─────────────────────────────────────
QDRANT__SERVICE__API_KEY=

# ─── Gitea ────────────────────────────────────────
GITEA_DB_PASSWD=

# ─── Nextcloud ────────────────────────────────────
NEXTCLOUD_MYSQL_PASSWORD=
NEXTCLOUD_MYSQL_ROOT_PASSWORD=

# ─── NocoDB ──────────────────────────────────────
NC_AUTH_JWT_SECRET=
NOCODB_DB_PASSWORD=
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=

# ─── Metabase ────────────────────────────────────
MB_DB_PASS=

# ─── Portainer (used by Glance dashboard) ────────
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=

# ─── n8n / Webhooks ──────────────────────────────
# WEBHOOK_URL: hostname only, no protocol (used by Glance)
# n8n compose builds its own full URL via https://n8n.${DOMAIN}
WEBHOOK_URL=n8n.example.com
N8N_API_KEY=

# ─── Spotify (YourSpotify) ───────────────────────
SPOTIFY_PUBLIC=
SPOTIFY_SECRET=

# ─── Instagram automation ────────────────────────
IGSHOT_API_KEY=

# ─── MediaManager ────────────────────────────────
MEDIAMANAGER_DB_PASSWORD=

# ─── Homepage / LoL widget ───────────────────────
PANDASCORE_API_KEY=
